---
import 'katex/dist/katex.min.css'
import { Image } from 'astro:assets'
import type { MarkdownHeading } from 'astro'
import type { CollectionEntry } from 'astro:content'

import BaseLayout from './BaseLayout.astro'
import Comment from '@/components/Comment.astro'
import Mermaid from '@/components/Mermaid.astro'
import Pageview from '@/components/Pageview.astro'
import TOC from '@/components/TOC.astro'
import { config } from '@/site-config'
import { formatDate, withBase } from '@/utils'
import { getBlogCollection, postUrl, sortMDByDate } from '@/utils/server'

interface Props {
  post: CollectionEntry<'blog'>
  headings: MarkdownHeading[]
  minutesRead: number
}

const { post, headings, minutesRead } = Astro.props
const { data } = post
const published = data.publishDate
const updated = data.updatedDate

// Neighbour posts (newer / older by publish date)
const allPosts = sortMDByDate(await getBlogCollection())
const index = allPosts.findIndex((p) => p.id === post.id)
const newerPost = index > 0 ? allPosts[index - 1] : undefined
const olderPost = index >= 0 && index < allPosts.length - 1 ? allPosts[index + 1] : undefined

const canonical = new URL(postUrl(post.id), Astro.site ?? 'https://example.com')

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: data.title,
  description: data.description,
  datePublished: published.toISOString(),
  ...(updated && { dateModified: updated.toISOString() }),
  author: { '@type': 'Person', name: config.site.author },
  mainEntityOfPage: canonical.href
}
---

<BaseLayout title={data.title} description={data.description} date={updated ?? published}>
  <!-- Reading progress -->
  <div id="reading-progress" aria-hidden="true"></div>

  <!-- No entrance animation here: the full article appears immediately
       (an opacity-0 fade-in reads as a dark flash on heavy pages). -->
  <div class="xl:grid xl:grid-cols-[minmax(0,1fr)_12.5rem] xl:gap-10">
    <TOC {headings} />

    <article class="min-w-0 xl:col-start-1 xl:row-start-1">
      <!-- Cover image (optimized: responsive sizes, eager for LCP, no CLS) -->
      {
        data.heroImage && (
          <Image
            src={data.heroImage.src}
            alt={data.heroImage.alt ?? data.title}
            widths={[640, 960, 1280]}
            sizes="(min-width: 1024px) 760px, 100vw"
            fetchpriority="high"
            loading="eager"
            decoding="async"
            class="mb-9 h-auto max-h-96 w-full rounded-2xl border border-line object-cover"
          />
        )
      }

      <!-- Post header -->
      <header class="mb-9">
        <h1 class="font-serif text-3xl font-semibold leading-tight sm:text-4xl">
          {data.draft && <span class="me-2 text-accent">[Draft]</span>}
          {data.title}
        </h1>

        <!-- Editorial-style meta: plain muted text, no chips -->
        <div class="mt-5 flex flex-wrap items-baseline gap-x-2 gap-y-1 text-sm text-ink-soft">
          <time datetime={published.toISOString()}>{formatDate(published)}</time>
          {
            updated && (
              <>
                <span aria-hidden="true">·</span>
                <span>Updated {formatDate(updated)}</span>
              </>
            )
          }
          <span aria-hidden="true">·</span>
          <span>{minutesRead} min read</span>
          {
            config.pageview.server && (
              <>
                <span aria-hidden="true">·</span>
                <Pageview />
              </>
            )
          }
          {
            data.tags.length > 0 && (
              <>
                <span aria-hidden="true">·</span>
                {data.tags.map((tag, i) => (
                  <>
                    <a href={withBase(`/tags/${tag}`)} class="link-ink" data-astro-prefetch>
                      #{tag}
                    </a>
                    {i < data.tags.length - 1 && <span class="text-ink-soft/50">/</span>}
                  </>
                ))}
              </>
            )
          }
        </div>
      </header>

      <!-- Article body -->
      <div class="prose prose-fill">
        <slot />
      </div>
      <Mermaid />

      <!-- Post footer -->
      <footer class="not-prose mt-14 border-t border-line pt-6">
        <p class="font-serif text-sm italic text-ink-soft">— End of article. Thanks for reading.</p>
        <div class="mt-4 flex flex-wrap items-center gap-3">
          <a href={withBase('/blog')} class="chip" data-astro-prefetch>
            <span class="i-lucide-arrow-left size-3.5" aria-hidden="true"></span>
            Back to blog
          </a>
          <a href="#top" class="chip">
            <span class="i-lucide-arrow-up size-3.5" aria-hidden="true"></span>
            Back to top
          </a>
        </div>

        <!-- Prev / next -->
        {
          (newerPost || olderPost) && (
            <nav class="mt-8 grid grid-cols-1 gap-3 sm:grid-cols-2" aria-label="Post navigation">
              {newerPost && (
                <a
                  href={postUrl(newerPost.id)}
                  class="paper-card group flex flex-col gap-1 p-4"
                  data-astro-prefetch
                >
                  <span class="flex items-center gap-1.5 text-xs text-ink-soft">
                    <span
                      class="i-lucide-arrow-left size-3.5 transition-transform duration-300 group-hover:-translate-x-1"
                      aria-hidden="true"
                    />
                    Previous
                  </span>
                  <span class="line-clamp-2 text-sm font-medium group-hover:text-accent">
                    {newerPost.data.title}
                  </span>
                </a>
              )}
              {olderPost && (
                <a
                  href={postUrl(olderPost.id)}
                  class="paper-card group flex flex-col gap-1 p-4 sm:text-end"
                  data-astro-prefetch
                >
                  <span class="flex items-center justify-end gap-1.5 text-xs text-ink-soft sm:flex-row-reverse">
                    <span
                      class="i-lucide-arrow-right size-3.5 transition-transform duration-300 group-hover:translate-x-1"
                      aria-hidden="true"
                    />
                    Next
                  </span>
                  <span class="line-clamp-2 text-sm font-medium group-hover:text-accent">
                    {olderPost.data.title}
                  </span>
                </a>
              )}
            </nav>
          )
        }

        {data.comment && <Comment />}
      </footer>
    </article>
  </div>

  <!-- BlogPosting structured data -->
  <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</BaseLayout>

<style>
  #reading-progress {
    position: fixed;
    inset-inline: 0;
    top: 0;
    z-index: 50;
    height: 3px;
    background-color: hsl(var(--accent) / 0.85);
    transform-origin: 0 50%;
    transform: scaleX(0);
    pointer-events: none;
  }
</style>

<script>
  const bar = document.getElementById('reading-progress')
  if (bar) {
    const onScroll = () => {
      const max = document.documentElement.scrollHeight - window.innerHeight
      bar.style.transform = `scaleX(${max > 0 ? Math.min(window.scrollY / max, 1) : 0})`
    }
    window.addEventListener('scroll', onScroll, { passive: true })
    onScroll()
  }
</script>
