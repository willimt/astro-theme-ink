---
import '@unocss/reset/tailwind.css'
import 'katex/dist/katex.min.css'
import '@/assets/styles/tokens.css'
import '@/assets/styles/global.css'

import BackToTop from '@/components/BackToTop.astro'
import Footer from '@/components/Footer.astro'
import Header from '@/components/Header.astro'
import Lightbox from '@/components/Lightbox.astro'
import { config } from '@/site-config'
import { THEME_COLORS, themeColorHex } from '@/utils/theme'

interface Props {
  title?: string
  description?: string
  /** ISO date of the page (for article meta) */
  date?: Date
  /** Path to an OG image (absolute, under public/) */
  ogImage?: string
  /** Disable page indexation */
  noindex?: boolean
}

const {
  title,
  description = config.site.description,
  date,
  ogImage = config.site.ogImage,
  noindex = false
} = Astro.props

const fullTitle = title
  ? `${title}${config.site.titleDelimiter}${config.site.title}`
  : config.site.title
const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://example.com')
const ogUrl = new URL(ogImage, Astro.site ?? 'https://example.com')
---

<!doctype html>
<html
  lang={config.site.lang}
  class="scroll-smooth"
  data-bg-ink-light={THEME_COLORS.ink.light}
  data-bg-ink-dark={THEME_COLORS.ink.dark}
  data-bg-fresh-light={THEME_COLORS.fresh.light}
  data-bg-fresh-dark={THEME_COLORS.fresh.dark}
  data-default-theme={config.site.theme}
  data-default-palette={config.site.palette}
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href={config.site.favicon} sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/favicon/apple-touch-icon.png" />
    <link rel="manifest" href="/favicon/site.webmanifest" />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content={themeColorHex(config.site.palette, false)} />

    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <!-- Open Graph -->
    <meta property="og:type" content={date ? 'article' : 'website'} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:site_name" content={config.site.title} />
    <meta name="twitter:card" content="summary_large_image" />

    {date && <meta property="article:published_time" content={date.toISOString()} />}

    <!-- Theme + palette, applied before first paint to avoid flash -->
    <script is:inline>
      ;(() => {
        const THEME_KEY = 'ink-theme'
        const PALETTE_KEY = 'ink-palette'
        const root = document.documentElement
        const stored = localStorage.getItem(THEME_KEY)
        const theme =
          stored === 'light' || stored === 'dark'
            ? stored
            : (root.dataset.defaultTheme ?? 'system')
        const dark =
          theme === 'dark' ||
          (theme === 'system' && matchMedia('(prefers-color-scheme: dark)').matches)
        const palette =
          localStorage.getItem(PALETTE_KEY) === 'fresh'
            ? 'fresh'
            : (root.dataset.defaultPalette ?? 'ink')
        root.classList.toggle('dark', dark)
        root.classList.toggle('fresh', palette === 'fresh')
        root.dataset.theme = theme
        root.dataset.palette = palette

        // Paint the html background before first paint (kills any canvas flash)
        // and keep theme-color in sync. Hex values ride on data attributes so
        // this works before the stylesheets load.
        const bg = root.dataset[`bg-${palette}-${dark ? 'dark' : 'light'}`]
        if (bg) {
          root.style.backgroundColor = bg
          const meta = document.querySelector('meta[name="theme-color"]')
          if (meta) meta.setAttribute('content', bg)
        }
      })()
    </script>
  </head>

  <body
    class="relative min-h-dvh bg-paper font-sans text-ink transition-colors duration-300"
    data-astro-page
  >
    <div id="ambient" aria-hidden="true"></div>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:start-4 focus:top-4 focus:z-50 focus:rounded-md focus:border focus:border-accent focus:bg-card focus:px-3 focus:py-2"
    >
      Skip to content
    </a>

    <div class="mx-auto flex min-h-dvh w-full max-w-5xl flex-col px-5 sm:px-8">
      <Header />
      <main id="main" class="flex-1 py-10">
        <slot />
      </main>
      <Footer />
    </div>
    <BackToTop />
    <Lightbox />
  </body>
</html>
