---
import '@unocss/reset/tailwind.css'
import '@/assets/styles/tokens.css'
import '@/assets/styles/global.css'

import Footer from '@/components/Footer.astro'
import Header from '@/components/Header.astro'
import { config } from '@/site-config'
import { themeColorHex } from '@/utils/theme'

interface Props {
  title?: string
  description?: string
  /** ISO date of the page (for article meta) */
  date?: Date
  /** Path to an OG image (absolute, under public/) */
  ogImage?: string
  /** Disable page indexation */
  noindex?: boolean
}

const {
  title,
  description = config.site.description,
  date,
  ogImage = config.site.ogImage,
  noindex = false
} = Astro.props

const fullTitle = title
  ? `${title}${config.site.titleDelimiter}${config.site.title}`
  : config.site.title
const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://example.com')
const ogUrl = new URL(ogImage, Astro.site ?? 'https://example.com')
---

<!doctype html>
<html lang={config.site.lang} class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href={config.site.favicon} sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/favicon/apple-touch-icon.png" />
    <link rel="manifest" href="/favicon/site.webmanifest" />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content={themeColorHex(config.site.palette, false)} />

    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <!-- Open Graph -->
    <meta property="og:type" content={date ? 'article' : 'website'} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:site_name" content={config.site.title} />
    <meta name="twitter:card" content="summary_large_image" />

    {date && <meta property="article:published_time" content={date.toISOString()} />}

    <!-- Theme + palette, applied before first paint to avoid flash -->
    <script is:inline>
      ;(() => {
        const THEME_KEY = 'ink-theme'
        const PALETTE_KEY = 'ink-palette'
        const stored = localStorage.getItem(THEME_KEY)
        const theme = stored === 'light' || stored === 'dark' ? stored : 'system'
        const dark =
          theme === 'dark' ||
          (theme === 'system' && matchMedia('(prefers-color-scheme: dark)').matches)
        const palette =
          localStorage.getItem(PALETTE_KEY) === 'fresh' ? 'fresh' : '${config.site.palette}'
        const root = document.documentElement
        root.classList.toggle('dark', dark)
        root.classList.toggle('fresh', palette === 'fresh')
        root.dataset.theme = theme
        root.dataset.palette = palette

        // theme-color derived from the live --paper token (no duplicated hexes)
        const meta = document.querySelector('meta[name="theme-color"]')
        if (meta) {
          const paper = getComputedStyle(root).getPropertyValue('--paper').trim()
          if (paper) {
            const [h, s, l] = paper.split(/\s+/).map(Number)
            const c = ((1 - Math.abs((2 * l) / 100 - 1)) * s) / 100
            const x = c * (1 - Math.abs(((h / 60) % 2) - 1))
            const m = l / 100 - c / 2
            let r = 0,
              g = 0,
              b = 0
            if (h < 60) {
              r = c
              g = x
            } else if (h < 120) {
              r = x
              g = c
            } else if (h < 180) {
              g = c
              b = x
            } else if (h < 240) {
              g = x
              b = c
            } else if (h < 300) {
              r = x
              b = c
            } else {
              r = c
              b = x
            }
            const toHex = (v) =>
              Math.round((v + m) * 255)
                .toString(16)
                .padStart(2, '0')
            meta.setAttribute('content', `#${toHex(r)}${toHex(g)}${toHex(b)}`)
          }
        }
      })()
    </script>
  </head>

  <body
    class="relative min-h-dvh bg-paper font-sans text-ink transition-colors duration-300"
    data-astro-page
  >
    <div id="ambient" aria-hidden="true"></div>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:start-4 focus:top-4 focus:z-50 focus:rounded-md focus:border focus:border-accent focus:bg-card focus:px-3 focus:py-2"
    >
      Skip to content
    </a>

    <div class="mx-auto flex min-h-dvh w-full max-w-5xl flex-col px-5 sm:px-8">
      <Header />
      <main id="main" class="flex-1 py-10">
        <slot />
      </main>
      <Footer />
    </div>

    <!-- Code block enhancements: language badge + copy button -->
    <script>
      document.addEventListener('astro:page-load', () => {
        document.querySelectorAll<HTMLElement>('.astro-code').forEach((block) => {
          if (block.dataset.enhanced) return
          block.dataset.enhanced = 'true'

          // Language badge from `data-language` (emitted by Astro's shiki)
          const lang = block.getAttribute('data-language')
          if (lang) {
            const badge = document.createElement('span')
            badge.className = 'code-lang'
            badge.textContent = lang
            block.appendChild(badge)
            block.classList.add('has-lang')
          }

          // Copy button
          const btn = document.createElement('button')
          btn.type = 'button'
          btn.className = 'code-copy'
          btn.innerHTML =
            '<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><rect width="14" height="14" x="8" y="8" rx="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg> Copy'
          btn.addEventListener('click', async () => {
            // `.astro-code` is the <pre> itself; read only the <code> so the
            // language badge and the copy button are not included.
            const text = block.querySelector('code')?.innerText ?? block.innerText
            try {
              await navigator.clipboard.writeText(text)
              btn.classList.add('copied')
              btn.innerHTML =
                '<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg> Copied!'
              setTimeout(() => {
                btn.classList.remove('copied')
                btn.innerHTML =
                  '<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><rect width="14" height="14" x="8" y="8" rx="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg> Copy'
              }, 1600)
            } catch {
              /* clipboard unavailable */
            }
          })
          block.appendChild(btn)

          // Collapse long blocks (> 15 lines) with a fade + pill toggle
          const lineCount = block.querySelectorAll('.line').length
          if (lineCount > 15) {
            block.classList.add('collapsed')
            const fade = document.createElement('div')
            fade.className = 'collapse-fade'
            const toggle = document.createElement('button')
            toggle.type = 'button'
            toggle.className = 'collapse-toggle'
            toggle.setAttribute('aria-expanded', 'false')
            toggle.innerHTML =
              '<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg><span class="desc"></span>'
            toggle.addEventListener('click', () => {
              const collapsed = block.classList.toggle('collapsed')
              toggle.setAttribute('aria-expanded', String(!collapsed))
            })
            block.append(fade, toggle)
          }
        })
      })
    </script>

    <!-- Scroll reveal -->
    <script>
      document.addEventListener('astro:page-load', () => {
        const els = document.querySelectorAll('.reveal')
        if (!els.length) return
        if (!('IntersectionObserver' in window)) {
          els.forEach((el) => el.classList.add('revealed'))
          return
        }
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('revealed')
                io.unobserve(entry.target)
              }
            })
          },
          { threshold: 0.12 }
        )
        els.forEach((el) => io.observe(el))
      })
    </script>
  </body>
</html>
