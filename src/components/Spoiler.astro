---
interface Props {
  class?: string
}

const { class: className } = Astro.props
---

<span class={['spoiler', className].filter(Boolean).join(' ')}><slot /></span>

<style>
  .spoiler {
    border-radius: 0.25rem;
    padding-inline: 0.3em;
    color: transparent;
    background-color: hsl(var(--wash) / 1);
    cursor: pointer;
    user-select: none;
    transition:
      color 0.25s ease,
      background-color 0.25s ease;
  }
  .spoiler:hover,
  .spoiler:focus-visible {
    color: inherit;
    background-color: transparent;
    user-select: text;
  }
  .spoiler:not(:hover) :global(*) {
    color: inherit !important;
    background-color: transparent !important;
  }
</style>
