<script>
  // Render ```mermaid fenced blocks to diagrams on the client.
  // The mermaid chunk is only loaded when a diagram actually exists on the
  // page, so articles without diagrams pay no cost.
  const blocks = document.querySelectorAll<HTMLElement>('.prose [data-language="mermaid"]')
  if (blocks.length > 0) {
    const { default: mermaid } = await import('mermaid')
    mermaid.initialize({
      startOnLoad: false,
      securityLevel: 'strict',
      suppressErrorRendering: true,
      theme: document.documentElement.classList.contains('dark') ? 'dark' : 'default'
    })
    for (const [index, block] of blocks.entries()) {
      // Shiki wraps <pre><code> alongside the title, language label and controls.
      const source = block.querySelector('pre > code')?.textContent?.trim()
      if (!source) continue
      try {
        const { svg } = await mermaid.render(`mermaid-${index}`, source)
        block.outerHTML = svg
      } catch (err) {
        // Leave the original highlighted source in place so the diagram stays readable.
        console.error('[mermaid] render failed:', err)
      }
    }
  }
</script>
