---
interface PageLink {
  title: string
  url: string
}

interface Props {
  prev?: PageLink
  next?: PageLink
}

const { prev, next } = Astro.props
---

<nav class="mt-10 flex items-stretch justify-between gap-3" aria-label="分页">
  {
    prev ? (
      <a
        href={prev.url}
        class="paper-card group flex max-w-[48%] flex-1 items-center gap-2 px-4 py-3"
        data-astro-prefetch
      >
        <span
          class="i-lucide-arrow-left size-4 text-accent transition-transform duration-300 group-hover:-translate-x-1"
          aria-hidden="true"
        />
        <span class="truncate text-sm font-medium">{prev.title}</span>
      </a>
    ) : (
      <span class="flex-1" aria-hidden="true" />
    )
  }
  {
    next && (
      <a
        href={next.url}
        class="paper-card group flex max-w-[48%] flex-1 items-center justify-end gap-2 px-4 py-3"
        data-astro-prefetch
      >
        <span class="truncate text-sm font-medium">{next.title}</span>
        <span
          class="i-lucide-arrow-right size-4 text-accent transition-transform duration-300 group-hover:translate-x-1"
          aria-hidden="true"
        />
      </a>
    )
  }
</nav>
