---
import { SOCIAL_ICONS } from '@/utils'
import { config } from '@/site-config'

const year = new Date().getFullYear()
const copyright = config.footer.copyright ?? `© ${year} ${config.site.author}`

const social = Object.entries(config.footer.social ?? {})
const footerLinks = config.footer.links ?? []
const socialItems = social.map(([key, item]) => ({
  ...item,
  icon: SOCIAL_ICONS[key] ?? 'i-lucide-link'
}))
---

<footer class="border-t border-line py-8 text-sm text-ink-soft">
  <div class="flex flex-col items-center gap-4 sm:flex-row sm:justify-between">
    <p class="flex flex-wrap items-center justify-center gap-x-2 gap-y-1 text-center">
      <span>{copyright}</span>
      {
        footerLinks.map((link) => (
          <>
            <span aria-hidden="true">·</span>
            <a href={link.url} class="link-ink">
              {link.title}
            </a>
          </>
        ))
      }
      <span aria-hidden="true">·</span>
      <span>
        Powered by <a href="https://astro.build" target="_blank" rel="noreferrer" class="link-ink"
          >Astro</a
        >
      </span>
    </p>

    {
      socialItems.length > 0 && (
        <div class="flex items-center gap-2">
          {socialItems.map((item) => (
            <a
              href={item.url}
              target="_blank"
              rel="noreferrer"
              aria-label={item.label}
              title={item.label}
              class="icon-link size-8"
            >
              <span class={`${item.icon} size-5`} aria-hidden="true" />
            </a>
          ))}
        </div>
      )
    }
  </div>
</footer>
