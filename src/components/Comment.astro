---
import { config } from '@/site-config'

// Waline stylesheet + our overrides live together in waline.css (import
// order guarantees our rules win) — see src/assets/styles/waline.css
import '@/assets/styles/waline.css'

const server = config.comment.server
const enabled = config.comment.provider === 'waline' && server !== ''
---

{
  enabled && (
    <section class="not-prose mt-14" aria-label="Comments">
      <h2 class="mb-4 flex items-center gap-2 font-serif text-lg font-semibold">
        <span class="i-lucide-message-square size-4 text-accent" aria-hidden="true" />
        Comments
      </h2>
      <div id="waline" />
    </section>
  )
}

<script>
  import { config } from '@/site-config'

  const server = config.comment.server
  const target = document.getElementById('waline')

  // Lazy-load Waline: initialize only when the comment section approaches the
  // viewport — saves ~190 KB of JS on the first paint of every post page.
  const initComment = async () => {
    const { init } = await import('@waline/client')
    init({
      el: '#waline',
      serverURL: server,
      lang: 'zh-CN',
      // page views are handled by the separate <Pageview /> component
      pageview: false,
      imageUploader: false,
      // Single heart "like" reaction — styling lives in waline.css
      reaction: ['/icons/heart-item.svg'],
      locale: {
        reaction0: 'Like(s)',
        reactionTitle: '这篇文章对你有帮助吗？',
        placeholder: 'Welcome to comment. (Email to receive replies. Login is unnecessary)'
      }
    })
  }

  if (server && target) {
    const observer = new IntersectionObserver(
      (entries) => {
        if (entries.some((e) => e.isIntersecting)) {
          observer.disconnect()
          initComment()
        }
      },
      { rootMargin: '600px 0px' }
    )
    observer.observe(target)
  }
</script>
