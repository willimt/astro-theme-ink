---
import BaseLayout from '@/layouts/BaseLayout.astro'
import { getBlogCollection, getUniqueTagsWithCount } from '@/utils/server'

const tags = getUniqueTagsWithCount(await getBlogCollection())
---

<BaseLayout title="标签" description={`${tags.length} 个标签`}>
  <div class="animate">
    <header class="mb-8">
      <h1 class="font-serif text-3xl font-semibold">标签</h1>
      <p class="mt-2 text-sm text-ink-soft">共 {tags.length} 个标签</p>
    </header>

    {
      tags.length === 0 ? (
        <p class="py-12 text-center text-ink-soft">暂无标签。</p>
      ) : (
        <div class="flex flex-wrap gap-2.5">
          {tags.map(([tag, count]) => (
            <a href={`/tags/${tag}`} class="chip !px-3.5 !py-1.5" data-astro-prefetch>
              #{tag}
              <span class="font-mono text-[11px] opacity-70">{count}</span>
            </a>
          ))}
        </div>
      )
    }
  </div>
</BaseLayout>
