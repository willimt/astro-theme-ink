---
import BaseLayout from '@/layouts/BaseLayout.astro'
import { withBase } from '@/utils'
import { getBlogCollection, getUniqueTagsWithCount } from '@/utils/server'

const tags = getUniqueTagsWithCount(await getBlogCollection())
---

<BaseLayout title="Tags" description={`${tags.length} tags`}>
  <div class="animate not-prose">
    <header class="mb-8">
      <h1 class="font-serif text-3xl font-semibold">Tags</h1>
      <p class="mt-2 text-sm text-ink-soft">{tags.length} tags</p>
    </header>

    {
      tags.length === 0 ? (
        <p class="py-12 text-center text-ink-soft">No tags yet.</p>
      ) : (
        <div class="flex flex-wrap gap-2.5">
          {tags.map(([tag, count]) => (
            <a href={withBase(`/tags/${tag}`)} class="chip !px-3.5 !py-1.5" data-astro-prefetch>
              #{tag}
              <span class="font-mono text-[11px] opacity-70">{count}</span>
            </a>
          ))}
        </div>
      )
    }
  </div>
</BaseLayout>
