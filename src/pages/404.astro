---
import BaseLayout from '@/layouts/BaseLayout.astro'
---

<BaseLayout title="页面不存在" noindex>
  <div class="animate flex flex-col items-center gap-6 py-20 text-center">
    <p class="font-serif text-7xl font-semibold text-accent">404</p>
    <p class="text-ink-soft">这片纸上没有你要找的内容。</p>
    <a href="/" class="chip !px-4 !py-1.5 text-sm" data-astro-prefetch>
      <span class="i-lucide-house size-4" aria-hidden="true"></span>
      回到首页
    </a>
  </div>
</BaseLayout>
