---
import { getCollection, render } from 'astro:content'
import type { CollectionEntry } from 'astro:content'
import type { GetStaticPaths } from 'astro'

import PostLayout from '@/layouts/PostLayout.astro'
import { getPostReadingTime } from '@/utils/server'

export const prerender = true

// Include drafts in the build so they stay reachable by URL.
// Folder posts (`mailserver/index.md`) get the folder as the slug.
export const getStaticPaths = (async () => {
  const posts = await getCollection('blog')
  return posts.map((post) => ({
    params: { slug: post.id.replace(/\/index$/, '') },
    props: { post }
  }))
}) satisfies GetStaticPaths

interface Props {
  post: CollectionEntry<'blog'>
}

const { post } = Astro.props as Props
const { Content, headings } = await render(post)
const minutesRead = getPostReadingTime(post)
---

<PostLayout post={post} {headings} {minutesRead}>
  <Content />
</PostLayout>
