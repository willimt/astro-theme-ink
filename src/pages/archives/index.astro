---
import BaseLayout from '@/layouts/BaseLayout.astro'
import { formatDate } from '@/utils'
import { getBlogCollection, groupByYear } from '@/utils/server'

const groups = groupByYear(await getBlogCollection())
---

<BaseLayout title="Archives" description="Posts grouped by year">
  <div class="animate">
    <header class="mb-8">
      <h1 class="font-serif text-3xl font-semibold">Archives</h1>
      <p class="mt-2 text-sm text-ink-soft">
        {[...groups.values()].reduce((n, g) => n + g.length, 0)} posts
      </p>
    </header>

    {
      groups.size === 0 ? (
        <p class="py-12 text-center text-ink-soft">No posts yet.</p>
      ) : (
        <div class="flex flex-col gap-10">
          {[...groups.entries()].map(([year, posts]) => (
            <section aria-label={`${year}`}>
              <h2 class="mb-4 flex items-baseline gap-3 font-serif text-2xl font-semibold">
                {year}
                <span class="font-mono text-sm font-normal text-ink-soft">
                  {posts.length} posts
                </span>
              </h2>
              <ul class="flex flex-col divide-y divide-line border-y border-line">
                {posts.map((post) => (
                  <li>
                    <a
                      href={`/blog/${post.id}`}
                      class="group flex items-baseline gap-4 py-2.5 transition-colors hover:text-accent"
                      data-astro-prefetch
                    >
                      <time
                        datetime={post.data.publishDate.toISOString()}
                        class="w-24 shrink-0 font-mono text-xs text-ink-soft"
                      >
                        {formatDate(post.data.publishDate, 'en-US', {
                          month: '2-digit',
                          day: '2-digit'
                        })}
                      </time>
                      <span class="truncate font-medium group-hover:underline group-hover:decoration-accent/60 group-hover:underline-offset-4">
                        {post.data.title}
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          ))}
        </div>
      )
    }
  </div>
</BaseLayout>
