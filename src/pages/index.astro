---
import BaseLayout from '@/layouts/BaseLayout.astro'
import PostCard from '@/components/PostCard.astro'
import { SOCIAL_ICONS } from '@/utils'
import { config } from '@/site-config'
import { getBlogCollection, getUniqueTagsWithCount, sortMDByDate } from '@/utils/server'

const { hero, recentPosts, education = [], skills = [], showTags, showFriends } = config.home

const posts = sortMDByDate(await getBlogCollection())
const recent = recentPosts > 0 ? posts.slice(0, recentPosts) : []
const tags = getUniqueTagsWithCount(posts).slice(0, 12)

const socialItems = Object.entries(config.footer.social ?? {}).map(([key, item]) => ({
  ...item,
  icon: SOCIAL_ICONS[key] ?? 'i-lucide-link'
}))
---

<BaseLayout>
  <!-- Hero -->
  <div
    id="content-header"
    class="animate not-prose mb-16 flex flex-col items-center gap-6 text-center"
  >
    <div class="relative">
      <div
        class="absolute -inset-5 rounded-full bg-gradient-to-br from-accent/25 via-accent/10 to-transparent blur-2xl"
        aria-hidden="true"
      >
      </div>
      <img
        src={config.site.avatar}
        alt={config.site.author}
        width="96"
        height="96"
        class="relative size-24 rounded-full border-2 border-line bg-card object-cover p-1 shadow-sm"
      />
    </div>

    <div class="flex flex-col items-center gap-4">
      {hero.tagline && <p class="chip font-mono tracking-widest uppercase">{hero.tagline}</p>}

      <h1 class="font-serif text-4xl font-semibold leading-tight sm:text-5xl">
        <span class="bg-gradient-to-r from-accent to-accent/40 bg-clip-text text-transparent">
          {config.site.author}
        </span>
      </h1>

      <div class="flex flex-wrap items-center justify-center gap-2.5">
        {
          hero.location && (
            <span class="chip">
              <span class="i-lucide-map-pin size-3.5" aria-hidden="true" />
              {hero.location}
            </span>
          )
        }
        {
          socialItems.map((item) => (
            <a
              href={item.url}
              target="_blank"
              rel="noreferrer"
              aria-label={item.label}
              title={item.label}
              class="icon-link size-9"
            >
              <span class={`${item.icon} size-4`} aria-hidden="true" />
            </a>
          ))
        }
      </div>

      {hero.about && <p class="max-w-2xl text-base leading-relaxed text-ink-soft">{hero.about}</p>}

      {
        hero.buttons && hero.buttons.length > 0 && (
          <div class="flex flex-wrap items-center justify-center gap-3">
            {hero.buttons.map((btn) => (
              <a href={btn.link} class="chip !px-4 !py-1.5 text-sm" data-astro-prefetch>
                {btn.title}
              </a>
            ))}
          </div>
        )
      }
    </div>
  </div>

  <!-- Recent posts -->
  {
    recent.length > 0 && (
      <section aria-label="Posts" class="reveal not-prose mb-16">
        <div class="mb-5 flex items-end justify-between">
          <h2 class="flex items-center gap-2.5 font-serif text-2xl font-semibold">
            <span
              class="size-2.5 rounded-full bg-gradient-to-br from-accent to-accent/40"
              aria-hidden="true"
            />
            Posts
          </h2>
          <a href="/blog" class="link-ink text-sm" data-astro-prefetch>
            More posts →
          </a>
        </div>
        <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
          {recent.map((post, i) => (
            <PostCard
              post={post}
              class={recent.length % 2 === 1 && i === recent.length - 1 ? 'md:col-span-2' : ''}
            />
          ))}
        </div>
      </section>
    )
  }

  <!-- Education -->
  {
    education.length > 0 && (
      <section aria-label="Education" class="reveal not-prose mb-16">
        <div class="mb-5 flex items-end justify-between">
          <h2 class="flex items-center gap-2.5 font-serif text-2xl font-semibold">
            <span
              class="size-2.5 rounded-full bg-gradient-to-br from-accent to-accent/40"
              aria-hidden="true"
            />
            Education
          </h2>
        </div>
        <div class="paper-card divide-y divide-line overflow-hidden">
          {education.map((item) => (
            <div class="flex flex-col gap-1 px-5 py-4 sm:flex-row sm:items-baseline sm:justify-between">
              <div>
                <p class="font-serif font-semibold leading-snug">{item.school}</p>
                {(item.major || item.degree) && (
                  <p class="mt-0.5 text-sm text-ink-soft">
                    {[item.major, item.degree].filter(Boolean).join(' · ')}
                  </p>
                )}
              </div>
              <p class="shrink-0 font-mono text-xs text-ink-soft sm:ms-6">{item.date}</p>
            </div>
          ))}
        </div>
      </section>
    )
  }

  <!-- Skills -->
  {
    skills.length > 0 && (
      <section aria-label="Skills" class="reveal not-prose mb-16">
        <div class="mb-5 flex items-end justify-between">
          <h2 class="flex items-center gap-2.5 font-serif text-2xl font-semibold">
            <span
              class="size-2.5 rounded-full bg-gradient-to-br from-accent to-accent/40"
              aria-hidden="true"
            />
            Skills
          </h2>
        </div>
        <div class="flex flex-col gap-5">
          {skills.map((group) => (
            <div>
              <h3 class="mb-2 text-sm font-semibold uppercase tracking-widest text-ink-soft">
                {group.title}
              </h3>
              <div class="flex flex-wrap gap-2">
                {group.items.map((item) => (
                  <span class="chip">{item}</span>
                ))}
              </div>
            </div>
          ))}
        </div>
      </section>
    )
  }

  <!-- Tags (optional) -->
  {
    showTags && tags.length > 0 && (
      <section aria-label="Tags" class="reveal not-prose mb-16">
        <div class="mb-5 flex items-end justify-between">
          <h2 class="flex items-center gap-2.5 font-serif text-2xl font-semibold">
            <span
              class="size-2.5 rounded-full bg-gradient-to-br from-accent to-accent/40"
              aria-hidden="true"
            />
            Tags
          </h2>
          <a href="/tags" class="link-ink text-sm" data-astro-prefetch>
            All tags →
          </a>
        </div>
        <div class="flex flex-wrap gap-2">
          {tags.map(([tag, count]) => (
            <a href={`/tags/${tag}`} class="chip" data-astro-prefetch>
              #{tag}
              <span class="font-mono text-[10px] opacity-70">{count}</span>
            </a>
          ))}
        </div>
      </section>
    )
  }

  <!-- Friends (optional) -->
  {
    showFriends && config.friends.length > 0 && (
      <section aria-label="Friends" class="reveal not-prose">
        <div class="mb-5 flex items-end justify-between">
          <h2 class="flex items-center gap-2.5 font-serif text-2xl font-semibold">
            <span
              class="size-2.5 rounded-full bg-gradient-to-br from-accent to-accent/40"
              aria-hidden="true"
            />
            Friends
          </h2>
          <a href="/links" class="link-ink text-sm" data-astro-prefetch>
            All friends →
          </a>
        </div>
        <div class="grid grid-cols-1 gap-3 sm:grid-cols-3">
          {config.friends.slice(0, 3).map((friend) => (
            <a
              href={friend.url}
              target="_blank"
              rel="noreferrer"
              class="paper-card group flex items-center gap-3 px-4 py-3"
            >
              {friend.avatar && (
                <img
                  src={friend.avatar}
                  alt=""
                  loading="lazy"
                  class="size-9 shrink-0 rounded-full border border-line bg-wash object-cover"
                />
              )}
              <span class="min-w-0">
                <span class="block truncate font-serif font-semibold group-hover:text-accent">
                  {friend.name}
                </span>
                <span class="block truncate text-xs text-ink-soft">{friend.desc}</span>
              </span>
            </a>
          ))}
        </div>
      </section>
    )
  }
</BaseLayout>
